PORT=3000
# Fichier de la base SQLite (créé au démarrage)
FICHIER_BASE=donnees/app.db
# Notification Discord à la fin de chaque tirage (facultatif) : adresse du webhook, SECRÈTE, jamais dans le dépôt.
# Seuls des chiffres anonymes sont envoyés (participants, durée, charge du serveur), jamais un nom ni une adresse.
DISCORD_WEBHOOK_URL=
